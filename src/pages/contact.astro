      height: 250px;
    }

    .instagram-section h3 {
      font-size: 60px;
    }

    .instagram-box {
      border: 3px solid #5e3023;
      padding: 6px 10px;
      width: 250px;
    }

    .instagram-icon {
      width: 20px;
      height: 20px;
    }

    .instagram-box p {
      font-size: 16px;
    }
  } */

  /* Media query para pantallas medianas */
  /* @media (min-width: 768px) and (max-width: 1023px) {
    .instagram-section {
      height: 250px;
    }

    .instagram-section h3 {
      font-size: 70px;
    }

    
    .instagram-box {
      border: 4px solid #5e3023;
      padding: 8px 16px;
    }

    .instagram-icon {
      width: 25px;
      height: 25px;
    }

    .instagram-box p {
      font-size: 20px;
    }
  } */

  /* Media query para pantallas grandes */
  /* @media (min-width: 1024px) and (max-width: 1479px) {
    .instagram-section {
      height: 250px;
    }

    .instagram-section h3 {
      font-size: 70px;
    }

    .instagram-box {
      border: 4px solid #5e3023;
      padding: 8px 16px;
    }

    .instagram-icon {
      width: 25px;
      height: 25px;
    }

    .instagram-box p {
      font-size: 20px;
    }
  } */
</style>
