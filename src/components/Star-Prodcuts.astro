---
import CarouselProductos from "./Carousel-Productos/CarouselProductos.jsx"
---

<section class="star-products">
  <h2 class="title">Distruta de nuestros productos destacados</h2>
  <div class="carousel-wrapper">
    <CarouselProductos client:only="react" />
  </div>
</section>

<style>
.star-products {
  background: #F3E9DC;
  text-align: center; 
  padding: clamp(1rem, 2vw, 3rem) 0;
  width: 100%;
  overflow: hidden;
}

.title {
  margin: 0px auto 0px;
  margin-bottom: clamp(20px, 4vw, 30px);
  font-weight: normal;
  font-size: 100px;
  font-size: clamp(45px, 8vw, 100px);
  color: #5e3023;
  word-wrap: break-word;
  font-family: 'Waterfall', sans-serif;
  text-align: center;
  display: block;
  width: 100%;
}
</style>
